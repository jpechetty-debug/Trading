GEMINI_API_KEY=your_actual_api_key_here

# --- Live signal alerts (optional — src/notifications.py) ---
# Both channels are independently optional; leave either blank to disable it.
#
# Telegram: message @BotFather -> /newbot to get a token, then message
# your new bot once and hit https://api.telegram.org/bot<token>/getUpdates
# to find your chat_id in the response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Email: if using Gmail, this must be an App Password (myaccount.google.com/apppasswords),
# not your normal login password — Gmail rejects plain-password SMTP logins.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_APP_PASSWORD=
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
